{
  "name": "fable-director",
  "repo": "frsorrentino/fable-director",
  "security": "advisory",
  "version_from": ".claude-plugin/plugin.json",
  "match": {
    "bash": [
      "(^|\\s|/)(fd-telemetry|external-exec|anonymizer)\\.py\\b",
      "fable-director/(?:[\\d.]+/)?scripts/[\\w-]+\\.(py|sh)\\b",
      "fable-director/(?:[\\d.]+/)?skills/[\\w-]+/tools/[\\w-]+\\.py\\b"
    ]
  },
  "benign_exits": {
    "cache-get": [
      1
    ],
    "test": [
      1
    ],
    "external-exec.py": [
      2
    ],
    "media-analyze.py": [
      2
    ]
  },
  "known": [
    {
      "call": "",
      "error": "fd-telemetry.py': [Errno 2] No such file or directory",
      "fixed_in": "1.61.1",
      "workaround": "the plugin scripts are not on PATH: run them by the full path that the kernel line «FD scripts» prints"
    },
    {
      "call": "",
      "error": "requires --paths",
      "fixed_in": "1.61.1",
      "workaround": "add --paths \"glob,glob\" to budget-open (or --paths none, the explicit waiver) on the agent, workflow and bg-session routes"
    }
  ]
}
